# ── Supabase (obligatorio) ──────────────────────────────────────
# Supabase → Project Settings → API. Sin estas tres variables la app muestra /configuracion.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clave publishable (sb_publishable_…). También sirve la "anon key" heredada en NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…) o la "service_role" heredada en SUPABASE_SERVICE_ROLE_KEY.
# SOLO SERVIDOR: nunca le pongas el prefijo NEXT_PUBLIC_ ni la pegues en un chat o un issue.
SUPABASE_SECRET_KEY=

# URL pública de la app: enlaces de confirmación de correo y HTTP-Referer de OpenRouter.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IA (OpenRouter) ─────────────────────────────────────────────
# Sin OPENROUTER_API_KEY la app usa la SIMULACIÓN, declarada en la interfaz.
# La clave solo se lee en el servidor; nunca uses el prefijo NEXT_PUBLIC_ para ella.
OPENROUTER_API_KEY=
# Modelo gratuito por defecto. Cualquier id de https://openrouter.ai/models que termine en ":free".
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Modelos de respaldo, en orden, separados por coma. Se usan si el principal está saturado (429),
# no existe o falla. Elegí 1–3 ids ":free" vigentes en https://openrouter.ai/models?max_price=0
OPENROUTER_FALLBACK_MODELS=
# Límites diarios por persona (0 = sin límite). Protegen el cupo gratis compartido de OpenRouter y Groq.
RAX_AI_DAILY_MESSAGES=150
# Fragmentos de ~15 s de audio transcritos por día (720 ≈ 3 horas de llamada).
RAX_AUDIO_DAILY_CHUNKS=720
# Hasta cuántos tokens de documentos del proyecto van completos al agente; por encima, se buscan fragmentos.
RAX_KNOWLEDGE_IN_CONTEXT_TOKENS=12000

# ── Integración n8n & Cloudflare Tunnel ─────────────────────────
# URL base pública expuesta por el túnel para webhooks de n8n
N8N_WEBHOOK_BASE_URL=https://n8n.tu-dominio.com/
# Clave compartida para validación de firma criptográfica HMAC-SHA256 (o usa SUPABASE_SECRET_KEY)
RAX_N8N_SHARED_SECRET=

# Cloudflare Tunnel (docker-compose)
CLOUDFLARED_TUNNEL_ID=7db304ca-f8b7-475b-899f-277390502c09
# Token de túnel gestionado (si se usa desde Cloudflare Zero Trust Dashboard)
CLOUDFLARED_TUNNEL_TOKEN=
